<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- TREE VIEW -->
    <!-- ================================================= -->

    <record id="classroom_tree_view" model="ir.ui.view">

        <field name="name">classroom.tree</field>

        <field name="model">university.classroom</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>

                <field name="name"/>

                <field name="subject_id"/>

                <field name="teacher_id"/>

                <field name="semester"/>

                <field name="year"/>

                <field name="student_count"/>

                <field name="active"/>

            </list>

        </field>

    </record>

    <!-- ================================================= -->
    <!-- FORM VIEW -->
    <!-- ================================================= -->

    <record id="classroom_form_view" model="ir.ui.view">

        <field name="name">classroom.form</field>

        <field name="model">university.classroom</field>

        <field name="arch" type="xml">

            <form string="Classroom">

                <sheet>

                    <!-- ========================================= -->
                    <!-- SMART BUTTON -->
                    <!-- ========================================= -->

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_students"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">

                            <field
                                name="student_count"
                                widget="statinfo"
                                string="Students"/>

                        </button>

                        <button
                            name="action_enrollments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">

                            <field
                                name="enrollment_count"
                                widget="statinfo"
                                string="Enrollments"/>

                        </button>

                        <button
                            name="action_grades"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-graduation-cap">

                            <field
                                name="grade_count"
                                widget="statinfo"
                                string="Grades"/>

                        </button>

                        <button
                            name="action_attendance"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check-square">

                            <field
                                name="attendance_count"
                                widget="statinfo"
                                string="Attendance"/>

                        </button>

                        <button
                            name="action_schedules"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar">

                            <field
                                name="schedule_count"
                                widget="statinfo"
                                string="Schedules"/>

                        </button>

                    </div>

                    <!-- ========================================= -->
                    <!-- INFORMATION -->
                    <!-- ========================================= -->

                    <group>

                        <group>

                            <field name="code"/>

                            <field name="name"/>

                            <field name="subject_id"/>

                            <field name="teacher_id"/>

                            <field name="room"/>

                        </group>

                        <group>

                            <field name="semester"/>

                            <field name="year"/>

                            <field name="max_student"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <group>

                        <field
                            name="note"
                            placeholder="Classroom note..."/>

                    </group>

                    <!-- ========================================= -->
                    <!-- NOTEBOOK -->
                    <!-- ========================================= -->

                    <notebook>
                                            <!-- ========================================= -->
                        <!-- STUDENTS -->
                        <!-- ========================================= -->

                        <page string="Students">

                            <field
                                name="student_ids"
                                readonly="1">

                                <list>

                                    <field name="student_code"/>

                                    <field name="name"/>

                                    <field name="gender"/>

                                    <field name="phone"/>

                                    <field name="email"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- ENROLLMENTS -->
                        <!-- ========================================= -->

                        <page string="Enrollments">

                            <field
                                name="enrollment_ids"
                                readonly="1">

                                <list>

                                    <field name="student_id"/>

                                    <field name="enroll_date"/>

                                    <field name="state"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- GRADES -->
                        <!-- ========================================= -->

                        <page string="Grades">

                            <field
                                name="grade_ids"
                                readonly="1">

                                <list
                                    decoration-success="status=='pass'"
                                    decoration-danger="status=='fail'">

                                    <field name="student_id"/>

                                    <field name="subject_id"/>

                                    <field name="teacher_id"/>

                                    <field name="attendance"/>

                                    <field name="midterm"/>

                                    <field name="final"/>

                                    <field name="total"/>

                                    <field name="letter_grade"/>

                                    <field name="classification"/>

                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- ATTENDANCE -->
                        <!-- ========================================= -->

                        <page string="Attendance">

                            <field
                                name="attendance_ids"
                                readonly="1">

                                <list>

                                    <field name="student_id"/>

                                    <field name="teacher_id"/>

                                    <field name="date"/>

                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- SCHEDULE -->
                        <!-- ========================================= -->

                        <page string="Schedules">

                            <field
                                name="schedule_ids"
                                readonly="1">

                                <list>

                                    <field name="subject_id"/>

                                    <field name="teacher_id"/>

                                    <field name="day_of_week"/>

                                    <field name="start_time"/>

                                    <field name="end_time"/>

                                    <field name="room"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>
        <!-- ================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ================================================= -->

    <!-- ================================================= -->
<!-- SEARCH VIEW -->
<!-- ================================================= -->

<record id="classroom_search_view" model="ir.ui.view">

    <field name="name">classroom.search</field>

    <field name="model">university.classroom</field>

    <field name="arch" type="xml">

        <search>

            <field name="code"/>
            <field name="name"/>
            <field name="subject_id"/>
            <field name="teacher_id"/>
            <field name="semester"/>
            <field name="year"/>

            <separator/>

            <filter
                name="filter_active"
                string="Active"
                domain="[('active','=',True)]"/>

            <separator/>

            <filter
                name="group_subject"
                string="Subject"
                context="{'group_by':'subject_id'}"/>

            <filter
                name="group_teacher"
                string="Teacher"
                context="{'group_by':'teacher_id'}"/>

            <filter
                name="group_semester"
                string="Semester"
                context="{'group_by':'semester'}"/>

            <filter
                name="group_year"
                string="Year"
                context="{'group_by':'year'}"/>

        </search>

    </field>

</record>

    <!-- ================================================= -->
    <!-- ACTION -->
    <!-- ================================================= -->

    <record id="action_classroom" model="ir.actions.act_window">

        <field name="name">Classrooms</field>

        <field name="res_model">university.classroom</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="classroom_search_view"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first classroom.
            </p>

            <p>
                Manage classrooms, students, enrollments,
                grades, attendance and schedules.
            </p>

        </field>

    </record>

</odoo>