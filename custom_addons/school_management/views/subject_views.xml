<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- TREE VIEW -->
    <!-- ================================================= -->

    <record id="subject_tree_view" model="ir.ui.view">

        <field name="name">subject.tree</field>

        <field name="model">university.subject</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>

                <field name="name"/>

                <field name="department_id"/>

                <field name="teacher_id"/>

                <field name="credit"/>

                <field name="student_count"/>

                <field name="classroom_count"/>

                <field name="active"/>

            </list>

        </field>

    </record>

    <!-- ================================================= -->
    <!-- FORM VIEW -->
    <!-- ================================================= -->

    <record id="subject_form_view" model="ir.ui.view">

        <field name="name">subject.form</field>

        <field name="model">university.subject</field>

        <field name="arch" type="xml">

            <form string="Subject">

                <sheet>

                    <!-- ========================================= -->
                    <!-- SMART BUTTON -->
                    <!-- ========================================= -->

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_classrooms"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-home">

                            <field
                                name="classroom_count"
                                widget="statinfo"
                                string="Classes"/>

                        </button>

                        <button
                            name="action_grades"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-graduation-cap">

                            <field
                                name="grade_count"
                                widget="statinfo"
                                string="Grades"/>

                        </button>

                        <button
                            name="action_schedules"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar">

                            <field
                                name="schedule_count"
                                widget="statinfo"
                                string="Schedules"/>

                        </button>

                    </div>

                    <!-- ========================================= -->
                    <!-- INFORMATION -->
                    <!-- ========================================= -->

                    <group>

                        <group>

                            <field name="code"/>

                            <field name="name"/>

                            <field name="department_id"/>

                            <field name="teacher_id"/>

                        </group>

                        <group>

                            <field name="credit"/>

                            <field name="theory_hours"/>

                            <field name="practice_hours"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <group>

                        <field
                            name="description"
                            placeholder="Subject description..."/>

                    </group>

                    <!-- ========================================= -->
                    <!-- NOTEBOOK -->
                    <!-- ========================================= -->

                    <notebook>
                                            <!-- ========================================= -->
                        <!-- CLASSROOM -->
                        <!-- ========================================= -->

                        <page string="Classes">

                            <field
                                name="classroom_ids"
                                readonly="1">

                                <list>

                                    <field name="code"/>

                                    <field name="name"/>

                                    <field name="teacher_id"/>

                                    <field name="semester"/>

                                    <field name="year"/>

                                    <field name="student_count"/>

                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- GRADES -->
                        <!-- ========================================= -->

                        <page string="Grades">

                            <field
                                name="grade_ids"
                                readonly="1">

                                <list
                                    decoration-success="status=='pass'"
                                    decoration-danger="status=='fail'">

                                    <field name="student_id"/>

                                    <field name="classroom_id"/>

                                    <field name="teacher_id"/>

                                    <field name="attendance"/>

                                    <field name="midterm"/>

                                    <field name="final"/>

                                    <field name="total"/>

                                    <field name="letter_grade"/>

                                    <field name="classification"/>

                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- SCHEDULE -->
                        <!-- ========================================= -->

                        <page string="Schedules">

                            <field
                                name="schedule_ids"
                                readonly="1">

                                <list>

                                    <field name="classroom_id"/>

                                    <field name="teacher_id"/>

                                    <field name="day_of_week"/>

                                    <field name="start_time"/>

                                    <field name="end_time"/>

                                    <field name="room"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>
    <record id="subject_search_view" model="ir.ui.view">

        <field name="name">subject.search</field>

        <field name="model">university.subject</field>

        <field name="arch" type="xml">

            <search>

                <field name="code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="teacher_id"/>
                <field name="credit"/>

                <separator/>

                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <separator/>

                <filter
                    name="group_department"
                    string="Department"
                    context="{'group_by':'department_id'}"/>

                <filter
                    name="group_teacher"
                    string="Teacher"
                    context="{'group_by':'teacher_id'}"/>

                <filter
                    name="group_credit"
                    string="Credit"
                    context="{'group_by':'credit'}"/>

            </search>

        </field>

    </record>

    <!-- ================================================= -->
    <!-- ACTION -->
    <!-- ================================================= -->

    <record id="action_subject" model="ir.actions.act_window">

        <field name="name">Subjects</field>

        <field name="res_model">university.subject</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="subject_search_view"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first subject.
            </p>

            <p>
                Manage subjects, teachers, classrooms,
                schedules and grades.
            </p>

        </field>

    </record>

</odoo>