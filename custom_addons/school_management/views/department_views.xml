<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- TREE VIEW -->
    <!-- ================================================= -->

    <record id="department_tree_view" model="ir.ui.view">

        <field name="name">department.tree</field>

        <field name="model">university.department</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>

                <field name="name"/>

                <field name="teacher_count"/>

                <field name="student_count"/>

                <field name="subject_count"/>

                <field name="active"/>

            </list>

        </field>

    </record>

    <!-- ================================================= -->
    <!-- FORM VIEW -->
    <!-- ================================================= -->

    <record id="department_form_view" model="ir.ui.view">

        <field name="name">department.form</field>

        <field name="model">university.department</field>

        <field name="arch" type="xml">

            <form string="Department">

                <sheet>

                    <!-- ========================================= -->
                    <!-- SMART BUTTON -->
                    <!-- ========================================= -->

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_teachers"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-user">

                            <field
                                name="teacher_count"
                                widget="statinfo"
                                string="Teachers"/>

                        </button>

                        <button
                            name="action_students"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">

                            <field
                                name="student_count"
                                widget="statinfo"
                                string="Students"/>

                        </button>

                        <button
                            name="action_subjects"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">

                            <field
                                name="subject_count"
                                widget="statinfo"
                                string="Subjects"/>

                        </button>

                    </div>

                    <!-- ========================================= -->
                    <!-- INFORMATION -->
                    <!-- ========================================= -->

                    <group>

                        <group>

                            <field name="code"/>

                            <field name="name"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field
                                name="description"
                                placeholder="Department description..."/>

                        </group>

                    </group>

                    <!-- ========================================= -->
                    <!-- NOTEBOOK -->
                    <!-- ========================================= -->

                    <notebook>
                                            <!-- ========================================= -->
                        <!-- TEACHERS -->
                        <!-- ========================================= -->

                        <page string="Teachers">

                            <field
                                name="teacher_ids"
                                readonly="1">

                                <list>

                                    <field name="code"/>

                                    <field name="name"/>

                                    <field name="degree"/>

                                    <field name="phone"/>

                                    <field name="email"/>

                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- STUDENTS -->
                        <!-- ========================================= -->

                        <page string="Students">

                            <field
                                name="student_ids"
                                readonly="1">

                                <list>

                                    <field name="student_code"/>

                                    <field name="name"/>

                                    <field name="gender"/>

                                    <field name="classroom_id"/>

                                    <field name="phone"/>

                                    <field name="email"/>

                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                        <!-- ========================================= -->
                        <!-- SUBJECTS -->
                        <!-- ========================================= -->

                        <page string="Subjects">

                            <field
                                name="subject_ids"
                                readonly="1">

                                <list>

                                    <field name="code"/>

                                    <field name="name"/>

                                    <field name="teacher_id"/>

                                    <field name="credit"/>

                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>
        <!-- ================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ================================================= -->

    <!-- ================================================= -->
<!-- SEARCH VIEW -->
<!-- ================================================= -->

<record id="department_search_view" model="ir.ui.view">

    <field name="name">department.search</field>

    <field name="model">university.department</field>

    <field name="arch" type="xml">

        <search>

            <field name="code"/>

            <field name="name"/>

            <filter
                name="filter_active"
                string="Active"
                domain="[('active','=',True)]"/>

            <filter
                name="group_name"
                string="Group by Department"
                context="{'group_by':'name'}"/>

        </search>

    </field>

</record>
    <!-- ================================================= -->
    <!-- ACTION -->
    <!-- ================================================= -->

    <record id="action_department" model="ir.actions.act_window">

        <field name="name">Departments</field>

        <field name="res_model">university.department</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="department_search_view"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first department.
            </p>

            <p>
                Manage departments, teachers, students and subjects.
            </p>

        </field>

    </record>

</odoo>