<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- TREE VIEW -->
    <!-- ================================================= -->

    <record id="enrollment_tree_view" model="ir.ui.view">

        <field name="name">enrollment.tree</field>

        <field name="model">university.enrollment</field>

        <field name="arch" type="xml">

            <list
                decoration-success="state=='confirmed'"
                decoration-warning="state=='draft'"
                decoration-danger="state=='cancel'">

                <field name="code"/>

                <field name="student_id"/>

                <field name="classroom_id"/>

                <field name="subject_id"/>

                <field name="teacher_id"/>

                <field name="semester"/>

                <field name="year"/>

                <field name="enroll_date"/>

                <field name="state"/>

            </list>

        </field>

    </record>

    <!-- ================================================= -->
    <!-- FORM VIEW -->
    <!-- ================================================= -->

    <record id="enrollment_form_view" model="ir.ui.view">

        <field name="name">enrollment.form</field>

        <field name="model">university.enrollment</field>

        <field name="arch" type="xml">

            <form string="Enrollment">

                <header>

                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>

                    <button
                        name="action_draft"
                        type="object"
                        string="Reset Draft"
                        invisible="state == 'draft'"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,cancel"/>

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="code"/>

                            <field name="student_id"/>

                            <field name="classroom_id"/>

                            <field name="subject_id"
                                   readonly="1"/>

                            <field name="teacher_id"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="semester"
                                   readonly="1"/>

                            <field name="year"
                                   readonly="1"/>

                            <field name="enroll_date"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <group>

                        <field
                            name="note"
                            placeholder="Enrollment note..."/>

                    </group>

                    <!-- ========================================= -->
                    <!-- NOTEBOOK -->
                    <!-- ========================================= -->

                    <notebook>
                                            <!-- ========================================= -->
                        <!-- INFORMATION -->
                        <!-- ========================================= -->

                        <page string="Enrollment Information">

                            <group>

                                <group>

                                    <field name="student_id" readonly="1"/>

                                    <field name="classroom_id" readonly="1"/>

                                    <field name="subject_id" readonly="1"/>

                                </group>

                                <group>

                                    <field name="teacher_id" readonly="1"/>

                                    <field name="semester" readonly="1"/>

                                    <field name="year" readonly="1"/>

                                </group>

                            </group>

                        </page>

                        <!-- ========================================= -->
                        <!-- NOTE -->
                        <!-- ========================================= -->

                        <page string="Note">

                            <field
                                name="note"
                                nolabel="1"
                                placeholder="Enter enrollment note..."/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>
        <!-- ================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ================================================= -->

    <!-- ================================================= -->
<!-- SEARCH VIEW -->
<!-- ================================================= -->

<record id="enrollment_search_view" model="ir.ui.view">

    <field name="name">enrollment.search</field>

    <field name="model">university.enrollment</field>

    <field name="arch" type="xml">

        <search>

            <field name="code"/>
            <field name="student_id"/>
            <field name="classroom_id"/>
            <field name="subject_id"/>
            <field name="teacher_id"/>
            <field name="semester"/>
            <field name="year"/>

            <separator/>

            <filter
                name="filter_draft"
                string="Draft"
                domain="[('state','=','draft')]"/>

            <filter
                name="filter_confirmed"
                string="Confirmed"
                domain="[('state','=','confirmed')]"/>

            <filter
                name="filter_cancel"
                string="Cancelled"
                domain="[('state','=','cancel')]"/>

            <separator/>

            <filter
                name="group_student"
                string="Student"
                context="{'group_by':'student_id'}"/>

            <filter
                name="group_classroom"
                string="Classroom"
                context="{'group_by':'classroom_id'}"/>

            <filter
                name="group_subject"
                string="Subject"
                context="{'group_by':'subject_id'}"/>

            <filter
                name="group_teacher"
                string="Teacher"
                context="{'group_by':'teacher_id'}"/>

            <filter
                name="group_semester"
                string="Semester"
                context="{'group_by':'semester'}"/>

            <filter
                name="group_year"
                string="School Year"
                context="{'group_by':'year'}"/>

        </search>

    </field>

</record>
    <!-- ================================================= -->
    <!-- ACTION -->
    <!-- ================================================= -->

    <record id="action_enrollment" model="ir.actions.act_window">

        <field name="name">Enrollments</field>

        <field name="res_model">university.enrollment</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="enrollment_search_view"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first enrollment.
            </p>

            <p>
                Manage student course registrations,
                classroom assignments and enrollment status.
            </p>

        </field>

    </record>

</odoo>